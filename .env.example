# =================================================================
# THE NEGOTIATOR: Environment Configuration Template
# Placeholders only. NEVER commit real API keys or server secrets.
# =================================================================

# OpenAI API Credentials
# NOTE: The Negotiator uses existing $5 API credit with zero auto-recharge.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview

# LiveKit WebRTC Configuration (Cloud or Self-Hosted)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Backend Service Connection
BACKEND_API_BASE_URL=http://localhost:4000/api

# Session Controls & Guardrails
AGENT_SESSION_MAX_SECONDS=90
AGENT_MAX_TEST_SESSIONS=5
AGENT_MODE=replay
ZERO_SPEND_ENFORCED=true
LOG_LEVEL=info
