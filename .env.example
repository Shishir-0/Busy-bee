# ==============================================================================
# The Negotiator (Busy-bee): Proof-First Procurement AI Engine
# Environment Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Server (apps/server)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Secret token required on internal agent endpoints (x-agent-token header)
AGENT_BACKEND_TOKEN=agent-negotiator-secret-2026

# Persistence: MongoDB Atlas Connection URI
# If omitted or unresolvable, the server seamlessly uses the In-Memory Repository
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/negotiator?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Voice Transport: LiveKit Cloud or Self-Hosted (apps/agent & src)
# ------------------------------------------------------------------------------
# Get your free cloud project URL and keys from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 3. AI Agent Configuration (apps/agent)
# ------------------------------------------------------------------------------
# OpenAI API Key (Realtime Speech-to-Speech API access)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview

# URL to communicate with the Backend API from the AI Agent worker
BACKEND_API_BASE_URL=http://localhost:4000/api

# Agent Operational Mode:
# 'replay' = Safe deterministic simulation of Merchant A & B negotiations (Default)
# 'voice'  = Live LiveKit WebRTC audio worker connecting to OpenAI Realtime
# 'text'   = Terminal text-based negotiation mode
# 'test'   = Automated headless test runner
AGENT_MODE=replay

# Safety, Governance & Cost Controls
AGENT_SESSION_MAX_SECONDS=90
AGENT_MAX_TEST_SESSIONS=5
ZERO_SPEND_ENFORCED=true
LOG_LEVEL=info
