# ==============================================================================
# The Negotiator: Proof-First Procurement AI - Full Environment Template
# Placeholders only. NEVER commit real API keys, credentials, or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Server
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Agent-to-Backend Security
# Secret shared between LiveKit AI Agent (Friend C) and Backend (Friend A / Shishir)
AGENT_BACKEND_TOKEN=agent-negotiator-secret-2026

# Persistence: MongoDB Atlas (Configured manually by Shishir)
# If omitted or connection fails, the server uses the verified In-Memory Repository
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/negotiator?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Voice Transport: LiveKit (WebRTC Cloud or Self-Hosted)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 3. AI Agent (Friend C - LiveKit Agents + OpenAI Realtime)
# ------------------------------------------------------------------------------
# Existing $5 OpenAI API credit reserved strictly for AI voice workstream
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
BACKEND_API_BASE_URL=http://localhost:4000/api

# Guardrails & Session Limits
AGENT_SESSION_MAX_SECONDS=90
AGENT_MAX_TEST_SESSIONS=5
AGENT_MODE=replay
ZERO_SPEND_ENFORCED=true
LOG_LEVEL=info
