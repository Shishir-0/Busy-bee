{
  "name": "@busy-bee/agent",
  "version": "1.0.0",
  "description": "AI Realtime Voice & Negotiation Intelligence Engine for The Negotiator",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "start:replay": "tsx src/index.ts --mode=replay",
    "start:text": "tsx src/index.ts --mode=text",
    "start:voice": "tsx src/index.ts --mode=voice"
  },
  "dependencies": {
    "@busy-bee/contracts": "file:../../packages/contracts",
    "zod": "^3.24.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8",
    "@types/node": "^22.13.9"
  }
}
